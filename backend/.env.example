# Lokal geliştirme şablonu — bu dosyayı `.env` olarak kopyalayıp doldurun.
# Docker'da bu değerler .env'den DEĞİL, backend/secrets/*.txt dosyalarından (Docker secret) gelir.
# Tüm alanlar ZORUNLUDUR; eksikse uygulama açılışta hata verir (fail-fast).

# OpenAI API anahtarı
OPENAI_API_KEY=sk-...

# MCP sunucu adresi
MCP_SERVER_URL=http://localhost:8000/mcp

# MongoDB bağlantısı (sohbet geçmişi)
MONGODB_URL=mongodb://localhost:27017

# PostgreSQL bağlantısı (runtime ayarlar)
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mevzuat_chatbot

# Admin ayar endpoint'i için token
ADMIN_TOKEN=change-me-locally

# Frontend origin (CORS)
CLIENT_URL=http://localhost:3000

